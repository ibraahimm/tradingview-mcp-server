{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tadawul-research/spec/vectors/case.schema.json",
  "title": "Golden vector case manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "spec_version", "target", "input_file", "expected_file", "tolerance"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "spec_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["function", "expr"]},
        "id": {"type": "string"},
        "params": {"type": "object"}
      }
    },
    "input_file": {"type": "string"},
    "expected_file": {"type": "string"},
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["abs"],
      "properties": {
        "abs": {"type": "number", "minimum": 0},
        "rel": {"type": "number", "minimum": 0}
      }
    },
    "null_token": {"type": "string", "default": ""}
  }
}
